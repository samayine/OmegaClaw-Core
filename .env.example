# OmegaClaw-ALIS environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# ALIS API (required)
# ---------------------------------------------------------------------------
# Base URL of your ALIS server (no trailing slash)
ALIS_API_BASE_URL=https://api.alis.rejuve.bio

# Bearer token for ALIS API authentication
ALIS_API_TOKEN=your_alis_api_token_here

# ---------------------------------------------------------------------------
# LLM provider (one of: Anthropic, OpenAI, ASICloud, ASIOne, Ollama-local)
# ---------------------------------------------------------------------------
# provider=Anthropic
# LLM=claude-sonnet-5
# ANTHROPIC_API_KEY=your_key_here

# provider=OpenAI
# LLM=gpt-4o
# OPENAI_API_KEY=your_key_here

# provider=Ollama-local
# LLM=gemma4
# OLLAMA_API_KEY=ollama
# LLM_SERVER_LOCAL_URL=http://your-ollama-host:8001

# ---------------------------------------------------------------------------
# ChromaDB seeding (used by seed_pc_knowledge.py, not the container itself)
# ---------------------------------------------------------------------------
# URL of the running OmegaClaw container — used to POST /query for ChromaDB seeding
# Default is http://localhost:5051 (matches the docker-compose port mapping 5051:5050)
# OMEGACLAW_URL=http://localhost:5051
